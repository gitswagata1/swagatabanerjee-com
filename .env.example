# Copy to .env.local for local development. In production, set these in Vercel → Settings → Environment Variables.

# Required for "Ask Swagata's AI". Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: override the chat model (default: claude-haiku-5-5)
# CHAT_MODEL=claude-haiku-5-5

# Recommended in production so the 10 messages / 10 minutes limit holds across serverless instances.
# Free database at https://upstash.com → Redis → REST API.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
